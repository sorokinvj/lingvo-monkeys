{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "lingvo-monkeys",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-11-01",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"routes": [{ "pattern": "lingvomonkeys.com", "custom_domain": true }],
	"workers_dev": true,
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference binding required by OpenNext (https://opennext.js.org/cloudflare/caching)
			"binding": "WORKER_SELF_REFERENCE",
			"service": "lingvo-monkeys"
		}
	],
	// next/image optimisation (https://opennext.js.org/cloudflare/howtos/image)
	"images": {
		"binding": "IMAGES"
	},
	"observability": {
		"enabled": true
	},
	"vars": {
		"AWS_REGION": "eu-west-2",
		"AWS_BUCKET_NAME": "lm-audio"
	}
	// Secrets (wrangler secret put): SUPABASE_SERVICE_ROLE_KEY, AWS_ACCESS_KEY_ID,
	// AWS_SECRET_ACCESS_KEY, DEEPGRAM_API_KEY. NEXT_PUBLIC_* are inlined at build
	// time from the GitHub Actions environment.
}
